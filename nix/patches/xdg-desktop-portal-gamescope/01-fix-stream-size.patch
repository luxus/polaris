+/// Query the PipeWire node's display resolution from its EnumFormat params.
+async fn query_node_size(node_id: u32) -> std::result::Result<(u32, u32), String> {
+    let output = tokio::process::Command::new("pw-cli")
+        .arg("enum-params")
+        .arg(node_id.to_string())
+        .arg("3")
+        .output()
+        .await
+        .map_err(|error| format!("failed to run pw-cli: {error}"))?;
+
+    if !output.status.success() {
+        let stderr = String::from_utf8_lossy(&output.stderr);
+        let detail = stderr.trim();
+        return Err(if detail.is_empty() {
+            format!("pw-cli exited with {}", output.status)
+        } else {
+            format!("pw-cli exited with {}: {detail}", output.status)
+        });
+    }
+
+    let stdout = String::from_utf8_lossy(&output.stdout);
+    for line in stdout.lines() {
+        if let Some(rect) = line.trim().strip_prefix("Rectangle ") {
+            if let Some((width, height)) = rect.split_once('x') {
+                let width = width
+                    .trim()
+                    .parse::<u32>()
+                    .map_err(|error| format!("invalid pw-cli width {width:?}: {error}"))?;
+                let height = height
+                    .trim()
+                    .parse::<u32>()
+                    .map_err(|error| format!("invalid pw-cli height {height:?}: {error}"))?;
+                if width == 0 || height == 0 {
+                    return Err(format!("pw-cli returned invalid resolution {width}x{height}"));
+                }
+                return Ok((width, height));
+            }
+        }
+    }
+
+    Err("pw-cli response contained no Rectangle resolution".to_string())
+}
