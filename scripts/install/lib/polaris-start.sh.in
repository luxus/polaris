#!/usr/bin/env bash
# Seed config and exec polaris (generated by 03-install-gamescope-stack.sh).
set -euo pipefail
confdir="${XDG_CONFIG_HOME:-$HOME/.config}/polaris"
mkdir -p "$confdir"
if [ ! -f "$confdir/polaris.conf" ]; then
  if [ -f "@CONF_SEED@" ]; then
    cp "@CONF_SEED@" "$confdir/polaris.conf"
  else
    cat >"$confdir/polaris.conf" <<'EOF'
headless_mode = enabled
linux_use_cage_compositor = enabled
linux_prefer_gpu_native_capture = disabled
linux_stream_mode = gamescope_stream
capture = portal
encoder = nvenc
hevc_mode = 3
av1_mode = 0
stream_audio = enabled
enable_pairing = enabled
enable_discovery = enabled
max_sessions = 2
EOF
  fi
  chmod 600 "$confdir/polaris.conf"
fi
exec "@POLARIS_BIN@"
